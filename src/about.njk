---
layout: base.njk
title: About
permalink: /about/
---
<section class="page-head">
  <div class="wrap">
    <h1>{{ about.intro }}</h1>
  </div>
</section>
<section class="paper about">
  <div class="wrap about-inner">
    <div class="prose about-prose">{{ about.body | paras | safe }}</div>
    <aside class="about-side">
      {% if about.image %}<figure class="bio-photo"><img src="{{ about.image }}" alt="{{ settings.owner }}"></figure>{% endif %}
      {% if about.highlights.length %}
      <h2>Current roles</h2>
      <ul class="roles">{% for h in about.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
      {% endif %}
    </aside>
  </div>
</section>
{% include "cta.njk" %}
