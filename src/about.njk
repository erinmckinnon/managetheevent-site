---
layout: base.njk
title: About
permalink: /about/
---
<section class="page-head">
  <div class="wrap about-grid">
    <div>
      <p class="eyebrow">About</p>
      <h1>{{ about.intro }}</h1>
      <div class="prose">{{ about.body | paras | safe }}</div>
      <a class="btn btn-primary" href="/contact/">Work with me</a>
    </div>
    <aside>
      {% if about.image %}<div class="about-photo"><img src="{{ about.image }}" alt="{{ settings.owner }}"></div>{% endif %}
      {% if about.highlights.length %}
      <h2 class="small-h">Right now</h2>
      <ul class="ticks">{% for h in about.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
      {% endif %}
    </aside>
  </div>
</section>
{% include "cta.njk" %}
