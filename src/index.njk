---
layout: base.njk
bodyClass: home
---
<section class="stage" data-spotlight>
  <div class="stage-light" aria-hidden="true"></div>
  <div class="wrap stage-inner">
    <div class="stage-grid">
      <div class="stage-copy">
        <h1 class="stage-title">{{ home.hero_title }}</h1>
        <p class="stage-intro">{{ home.hero_intro }}</p>
        <div class="stage-actions">
          <a class="btn btn-brass" href="/contact/">Start a project</a>
          <a class="btn btn-line" href="/work/">See the work</a>
        </div>
      </div>
      {% if home.hero_image %}<figure class="stage-photo"><img src="{{ home.hero_image }}" alt="Erin McKinnon" width="1051" height="1100"></figure>{% endif %}
    </div>
    {% if home.hero_note %}<p class="stage-note"><span class="live" aria-hidden="true"></span>{{ home.hero_note }}</p>{% endif %}
  </div>
</section>

<section class="manifesto">
  <div class="wrap manifesto-inner">
    <h2>{{ home.manifesto_title }}</h2>
    <div class="manifesto-text">{{ home.manifesto_text | paras | safe }}</div>
  </div>
</section>

<section class="features" aria-labelledby="work-h">
  <div class="wrap features-head">
    <h2 id="work-h">Recent work</h2>
    <a class="text-link" href="/work/">All six case studies</a>
  </div>
  {% for item in collections.work | featuredFirst | head(3) %}
  <article class="feature{% if loop.index is even %} flip{% endif %}">
    <a class="feature-img" href="{{ item.url }}" tabindex="-1" aria-hidden="true"><img src="{{ item.data.image }}" alt="" loading="lazy"></a>
    <div class="feature-copy">
      {% if item.data.figure %}<p class="figure">{{ item.data.figure }}</p><p class="figure-label">{{ item.data.figure_label }}</p>{% endif %}
      <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
      <p class="feature-client">{{ item.data.client }}</p>
    </div>
  </article>
  {% endfor %}
</section>

<section class="ros" aria-labelledby="ros-h">
  <div class="wrap">
    <div class="ros-head">
      <h2 id="ros-h">{{ home.ros_title }}</h2>
      <p>{{ home.ros_intro }}</p>
    </div>
    <ol class="ros-sheet">
      {% for r in home.run_of_show %}
      <li><span class="ros-when">{{ r.when }}</span><span class="ros-cue">{{ r.cue }}</span><span class="ros-text">{{ r.text }}</span></li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="services" id="services" aria-labelledby="svc-h">
  <div class="wrap">
    <h2 id="svc-h">{{ home.services_title }}</h2>
    <div class="services-list">
      {% for s in home.services %}<div class="service"><h3>{{ s.title }}</h3><p>{{ s.text }}</p></div>{% endfor %}
    </div>
  </div>
</section>

<section class="bio" aria-labelledby="bio-h">
  <div class="wrap bio-inner">
        <div class="bio-copy">
      <h2 id="bio-h">{{ home.bio_title }}</h2>
      {{ home.bio_text | paras | safe }}
      <a class="text-link" href="/about/">The longer story</a>
    </div>
  </div>
</section>

<section class="credits" aria-labelledby="credits-h">
  <div class="wrap">
    <h2 id="credits-h">{{ home.credits_title }}</h2>
    <div class="credits-roll">
      {% for c in home.credits %}<div class="credit"><h3>{{ c.group }}</h3><p>{% for n in c.names %}<span>{{ n }}</span>{% endfor %}</p></div>{% endfor %}
    </div>
  </div>
</section>

{% include "cta.njk" %}
