---
layout: base.njk
title: Contact
permalink: /contact/
summary: Tell Erin McKinnon about your event, campaign, or program.
---
<section class="page-head">
  <div class="wrap contact-grid">
    <div>
      <p class="eyebrow">Contact</p>
      <h1>Let's talk about what you're running.</h1>
      <p class="lede">Events, campaigns, field programs, operations systems, or a situation that needs handling. Send a note and I'll get back to you.</p>
      <ul class="contact-list">
        <li>{{ settings.location }}, working nationwide</li>
        {% if settings.email %}<li><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>{% endif %}
        {% if settings.phone %}<li><a href="tel:{{ settings.phone | tel }}">{{ settings.phone }}</a></li>{% endif %}
        {% if settings.linkedin %}<li><a href="{{ settings.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>{% endif %}
      </ul>
    </div>
    <form class="form" name="contact" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="company_website">
      <input type="hidden" name="form-name" value="contact">
      <p class="hp"><label>Leave this empty <input name="company_website"></label></p>
      <label>Name<input name="name" required autocomplete="name"></label>
      <label>Email<input type="email" name="email" required autocomplete="email"></label>
      <label>Organization <span class="opt">(optional)</span><input name="organization" autocomplete="organization"></label>
      <label>What do you need help with?
        <select name="type">
          <option>An event</option><option>A campaign</option><option>A brand activation or sampling program</option><option>An Airtable or operations system</option><option>Recaps or reporting</option><option>Something else</option>
        </select>
      </label>
      <label>Date or timeline <span class="opt">(optional)</span><input name="timeline"></label>
      <label>Tell me about it<textarea name="message" rows="6" required></textarea></label>
      <button class="btn btn-primary" type="submit">Send</button>
    </form>
  </div>
</section>
