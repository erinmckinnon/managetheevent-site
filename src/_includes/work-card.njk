<a class="card" href="{{ item.url }}">
  <div class="card-img"><img src="{{ item.data.image }}" alt="" loading="lazy"></div>
  <div class="card-body">
    <p class="eyebrow">{{ item.data.category }}{% if item.data.client %} · {{ item.data.client }}{% endif %}</p>
    <h3>{{ item.data.title }}</h3>
    <p class="muted">{{ item.data.summary }}</p>
    <span class="more">Read the case study <span aria-hidden="true">→</span></span>
  </div>
</a>
