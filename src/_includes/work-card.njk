<a class="tile" href="{{ item.url }}">
  <span class="tile-img"><img src="{{ item.data.image }}" alt="" loading="lazy"></span>
  {% if item.data.figure %}<span class="tile-figure">{{ item.data.figure }}</span>{% endif %}
  <span class="tile-title">{{ item.data.title }}</span>
  <span class="tile-client">{{ item.data.client }}</span>
</a>
