---
layout: base.njk
---
<article class="case">
  <header class="case-head">
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/work/">Work</a> · {{ category }}</p>
      <h1>{{ title }}</h1>
      {% if subtitle %}<p class="lede">{{ subtitle }}</p>{% endif %}
      <p class="meta">{% if client %}{{ client }} · {% endif %}<time datetime="{{ date | isoDate }}">{{ date | longDate }}</time> · By {{ settings.owner }}</p>
    </div>
    {% if image %}<div class="wrap case-hero"><img src="{{ image }}" alt=""></div>{% endif %}
  </header>
  <div class="wrap narrow prose">
    {{ content | safe }}
    {% if pdf %}<p class="pdf"><a class="btn btn-primary" href="{{ pdf }}" target="_blank" rel="noopener">View the full case study (PDF)</a></p>{% endif %}
  </div>
  {% if gallery and gallery.length %}
  <div class="wrap gallery">{% for g in gallery %}<img src="{{ g }}" alt="" loading="lazy">{% endfor %}</div>
  {% endif %}
</article>
<section class="section">
  <div class="wrap">
    <h2 class="section-title">More work</h2>
    <div class="grid cards">
      {% set shown = 0 %}
      {% for item in collections.work %}{% if item.url != page.url and shown < 3 %}{% set shown = shown + 1 %}{% include "work-card.njk" %}{% endif %}{% endfor %}
    </div>
  </div>
</section>
{% include "cta.njk" %}
