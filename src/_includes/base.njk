<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set pageTitle = (title + " | " + settings.site_title) if title else (settings.site_title + " | Erin McKinnon, events, campaigns and operations") %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ summary or settings.site_description }}">
  <meta name="theme-color" content="#170d15">
  <meta property="og:title" content="{{ title or settings.site_title }}">
  <meta property="og:description" content="{{ summary or settings.site_description }}">
  <meta property="og:image" content="{{ image or settings.share_image }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23170d15'/%3E%3Ctext x='50%25' y='56%25' text-anchor='middle' dominant-baseline='middle' font-family='Georgia,serif' font-style='italic' font-size='42' fill='%23c9a36a'%3EM%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash) && !location.pathname.startsWith('/admin')) location.replace('/admin/' + location.hash);
  </script>
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand"><img src="{{ settings.logo }}" alt="Manage the Event, home" width="120" height="96"></a>
      <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav id="nav" class="nav" aria-label="Main">
        <a href="/work/"{% if page.url == "/work/" %} aria-current="page"{% endif %}>Work</a>
        <a href="/#services">Services</a>
        <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
        <a class="nav-cta" href="/contact/">Start a project</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <img src="{{ settings.logo }}" alt="Manage the Event" width="140" height="112" loading="lazy" class="footer-logo">
      <p>Event management, campaign operations, and the systems behind them.<br>{{ settings.location }}, working nationwide.</p>
      <ul class="footer-links">
        <li><a href="/work/">Work</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        {% if settings.email %}<li><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>{% endif %}
        {% if settings.phone %}<li><a href="tel:{{ settings.phone | tel }}">{{ settings.phone }}</a></li>{% endif %}
        {% if settings.linkedin %}<li><a href="{{ settings.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>{% endif %}
        {% if settings.instagram %}<li><a href="{{ settings.instagram }}" target="_blank" rel="noopener">Instagram</a></li>{% endif %}
      </ul>
    </div>
    <p class="wrap footer-base">© {{ "" | year }} Manage the Event, {{ settings.owner }}</p>
  </footer>
  <script src="/js/site.js" defer></script>
</body>
</html>
